{
  "name": "@pi-vault/pi-dcp",
  "version": "0.9.0",
  "type": "module",
  "description": "Pi extension for dynamic context pruning — incremental tool output pruning and conversation compression",
  "author": "Lanh Hoang <lanhhoang@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/pi-vault/pi-dcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-vault/pi-dcp.git"
  },
  "bugs": {
    "url": "https://github.com/pi-vault/pi-dcp/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "pi-dcp",
    "context-pruning",
    "compression"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "tsx scripts/benchmark.ts",
    "analyze:sessions": "tsx scripts/analyze-sessions.ts",
    "generate:schema": "tsx scripts/generate-schema.ts > dcp.schema.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "pack:dry-run": "pnpm pack --dry-run",
    "release:check": "pnpm check && pnpm run generate:schema && pnpm run pack:dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "src",
    "dcp.schema.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-agent-core": "^1.0.1",
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@earendil-works/pi-tui": "^1.0.1",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
